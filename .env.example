# Copy this file to .env and fill in your own keys.
# In Replit, don't use a .env file at all -- put these in the Secrets panel instead
# (Tools -> Secrets), using the same names as below.

# Get a free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Free, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Any long random string -- used to sign session cookies for the free-plan quota tracker
SESSION_SECRET=change_this_to_a_random_string

PORT=3000
